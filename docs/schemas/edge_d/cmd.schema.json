{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0.0",
  "$id": "https://local.schemas/edge_d/cmd.schema.json",
  "title": "Edge-D 命令请求封包（U8→U1）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "msg_id",
    "cmd"
  ],
  "properties": {
    "msg_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string"
    },
    "cmd": {
      "type": "string",
      "enum": [
        "GET_STATUS",
        "GET_DEVICE_INFO",
        "HOME",
        "MOVE",
        "PAUSE",
        "RESUME",
        "STOP",
        "ESTOP",
        "PATH_BEGIN",
        "PATH_SEG",
        "PATH_END"
      ]
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "z": {
      "type": "number"
    },
    "feed": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "total_segments": {
      "type": "integer",
      "minimum": 0
    },
    "segment_index": {
      "type": "integer",
      "minimum": 0
    },
    "segment_cmd": {
      "type": "string",
      "enum": [
        "M",
        "L"
      ]
    },
    "relative": {
      "type": "boolean",
      "default": false,
      "description": "When true, x/y/z are interpreted as delta offsets from the current position; U8 converts relative moves to absolute coordinates before sending to U1."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cmd": {
            "const": "MOVE"
          }
        }
      },
      "then": {
        "required": [
          "feed"
        ],
        "anyOf": [
          {
            "required": [
              "x"
            ]
          },
          {
            "required": [
              "y"
            ]
          },
          {
            "required": [
              "z"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cmd": {
            "const": "PATH_BEGIN"
          }
        }
      },
      "then": {
        "required": [
          "total_segments",
          "feed"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cmd": {
            "const": "PATH_SEG"
          }
        }
      },
      "then": {
        "required": [
          "segment_index",
          "segment_cmd",
          "feed"
        ],
        "anyOf": [
          {
            "required": [
              "x"
            ]
          },
          {
            "required": [
              "y"
            ]
          },
          {
            "required": [
              "z"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cmd": {
            "const": "HOME"
          }
        }
      },
      "then": {
        "required": []
      }
    }
  ]
}
