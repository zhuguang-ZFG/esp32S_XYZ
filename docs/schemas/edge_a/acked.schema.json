{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0.0",
  "$id": "https://local.schemas/edge_a/acked.schema.json",
  "title": "Edge-A ack 确认响应（BusinessServer→Client WSS）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "topic",
    "seq"
  ],
  "properties": {
    "type": {
      "const": "acked"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    }
  }
}
