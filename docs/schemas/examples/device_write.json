{
  "_comment": "设备写字路由示例 - 预定义路径写字任务，不需要 AI 模型",
  "_note": "write_text 能力，text 由服务端渲染为路径，deterministic 策略",
  "type": "motion_task",
  "task_id": "write-001",
  "device_id": "dev-1",
  "capability": "run_path",
  "source": "voice",
  "route_policy": {
    "route_role": "device_write",
    "model_required": false,
    "primary_strategy": "deterministic",
    "artifact_required": "preview_svg"
  },
  "params": {
    "feed": 900,
    "text": "LiMa",
    "path": [
      {"x": 0, "y": 0, "z": 0},
      {"x": 10, "y": 10, "z": -5},
      {"x": 20, "y": 0, "z": 0}
    ],
    "preview_svg": "<svg viewBox='0 0 100 50'><text x='10' y='35' font-size='30'>LiMa</text></svg>"
  }
}
