@@ -21,6 +21,33 @@
 
 #define TAG "WifiConfigurationAp"
 
+
+static void SaveDlcProvisioningFields(const char* device_secret, const char* server_host) {
+    if ((!device_secret || device_secret[0] == '\0') && (!server_host || server_host[0] == '\0')) {
+        return;
+    }
+    nvs_handle_t nvs;
+    if (nvs_open("wifi", NVS_READWRITE, &nvs) != ESP_OK) {
+        ESP_LOGW(TAG, "dlc provisioning: failed to open wifi NVS");
+        return;
+    }
+    if (device_secret && device_secret[0] != '\0') {
+        if (strlen(device_secret) >= 128) {
+            ESP_LOGW(TAG, "dlc device_secret too long, skipping");
+        } else if (nvs_set_str(nvs, "device_secret", device_secret) == ESP_OK) {
+            ESP_LOGI(TAG, "dlc device_secret saved to NVS");
+        }
+    }
+    if (server_host && server_host[0] != '\0') {
+        if (strlen(server_host) >= 128) {
+            ESP_LOGW(TAG, "dlc server_host too long, skipping");
+        } else if (nvs_set_str(nvs, "server_host", server_host) == ESP_OK) {
+            ESP_LOGI(TAG, "dlc server_host saved to NVS");
+        }
+    }
+    nvs_commit(nvs);
+    nvs_close(nvs);
+}
+
 #define WIFI_CONNECTED_BIT BIT0
 #define WIFI_FAIL_BIT      BIT1
