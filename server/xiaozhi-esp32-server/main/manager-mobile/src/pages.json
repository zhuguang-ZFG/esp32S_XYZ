{
  "globalStyle": {
    "navigationStyle": "default",
    "navigationBarTitleText": "LiMa 星云",
    "navigationBarBackgroundColor": "#07070f",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#07070f"
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^fg-(.*)": "@/components/fg-$1/fg-$1.vue",
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "tabBar": {
    "custom": false,
    "color": "#5a6372",
    "selectedColor": "#3b82f6",
    "backgroundColor": "#0a0a14",
    "borderStyle": "black",
    "height": "50px",
    "fontSize": "10px",
    "iconWidth": "24px",
    "spacing": "3px",
    "list": [
      {
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/homeHL.png",
        "pagePath": "pages/index/index",
        "text": "星云",
        "icon": "home",
        "iconType": "uiLib"
      },
      {
        "iconPath": "static/tabbar/robot.png",
        "selectedIconPath": "static/tabbar/robot_activate.png",
        "pagePath": "pages/chat/chat",
        "text": "对话",
        "icon": "robot",
        "iconType": "uiLib"
      },
      {
        "iconPath": "static/tabbar/network.png",
        "selectedIconPath": "static/tabbar/network_activate.png",
        "pagePath": "pages/create/create",
        "text": "创作",
        "icon": "i-carbon-network-3",
        "iconType": "uiLib"
      },
      {
        "iconPath": "static/tabbar/system.png",
        "selectedIconPath": "static/tabbar/system_activate.png",
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "icon": "i-carbon-settings",
        "iconType": "uiLib"
      }
    ]
  },
  "pages": [
    {
      "path": "pages/index/index",
      "type": "home",
      "layout": "tabbar",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "LiMa 星云"
      }
    },
    {
      "path": "pages/chat/chat",
      "type": "page",
      "layout": "tabbar",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "AI 对话"
      }
    },
    {
      "path": "pages/create/create",
      "type": "page",
